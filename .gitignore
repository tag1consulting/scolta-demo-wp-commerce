# WordPress
wp-config-local.php
wp-config-sample.php
error_log

# ddev rewrites these on every start (they carry the #ddev-generated marker),
# so tracking them makes the tree dirty after any local ddev run. The container
# image supplies its own config via wp-config-container.php (see Dockerfile).
wp-config.php
wp-config-ddev.php
debug.log
*.log

# DDEV local overrides
.ddev/.gitignore
.ddev/import-db/
.ddev/sequelpro.spf
.ddev/db_snapshots/

# Node
node_modules/
npm-debug.log

# macOS
.DS_Store
**/.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Uploads - committed intentionally for demo
# wp-content/uploads is NOT gitignored

# WP core cache
wp-content/cache/
wp-content/upgrade/

# WooCommerce runtime directories
wp-content/uploads/wc-logs/
wp-content/uploads/woocommerce_uploads/

# Scolta runtime state (build output is committed, state is not)
wp-content/uploads/scolta/state/

# Composer
vendor/
.claude/
